# ==============================================================================
# FieldOps Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - In staging/production, configure these variables in your deployment platform's
#   secret management system (e.g., AWS Secrets Manager, Vercel, Vault).
# - NEVER commit .env, .env.local, or actual secret keys to source control.
# - Variables prefixed with NEXT_PUBLIC_ are exposed to web and mobile clients.
# - Variables without NEXT_PUBLIC_ are strictly server-side and must never leak.
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production

# ------------------------------------------------------------------------------
# Supabase & Database Configuration
# ------------------------------------------------------------------------------
# Public API URL for Supabase Gateway (Exposed to Web & Mobile clients)
NEXT_PUBLIC_SUPABASE_URL=https://prod-api.fieldops.com/supabase

# Public Anonymous Client Key (Exposed to Web & Mobile clients; respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-public-anon-key-replace-with-prod

# Privileged Service Role Key (STRICTLY SERVER-SIDE - NEVER EXPOSE TO CLIENTS)
# Used only by background workers, admin edge functions, and authorized workers
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-replace-with-prod

# Database Connection URLs (STRICTLY SERVER-SIDE)
# Transaction pooler URL (e.g. pgBouncer port 6543)
DATABASE_URL=postgresql://postgres.prod:prod-db-password@pooler.fieldops.com:6543/postgres?pgbouncer=true
# Direct connection URL (used for running migrations, port 5432)
DIRECT_URL=postgresql://postgres.prod:prod-db-password@db.fieldops.com:5432/postgres

# ------------------------------------------------------------------------------
# Server-Side Cryptographic & Storage Secrets (STRICTLY SERVER-SIDE)
# ------------------------------------------------------------------------------
# Master encryption secret for encrypting sensitive fields at rest (AES-256-GCM, 32 bytes hex)
SERVER_SECRET_MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Private storage bucket for photos, signatures, and attachments
SUPABASE_STORAGE_BUCKET=fieldops-media

# ------------------------------------------------------------------------------
# Web Client & API Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.fieldops.com
NEXT_PUBLIC_API_URL=https://app.fieldops.com/api/v1

# ------------------------------------------------------------------------------
# SaaS Billing Configuration (STRICTLY SERVER-SIDE)
# ------------------------------------------------------------------------------
# Billing Provider (mock | stripe | razorpay)
BILLING_PROVIDER=stripe
# Stripe production secret key
STRIPE_SECRET_KEY=sk_live_placeholder_replace_with_prod
# Stripe publishable key (exposed to client for checkout/portal redirects)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_placeholder_replace_with_prod
# Stripe webhook signing secret (used to verify HMAC-SHA256 signatures)
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_with_prod

# ------------------------------------------------------------------------------
# Geospatial & Map Provider Configuration
# ------------------------------------------------------------------------------
# Map tile provider (osm | mapbox | google)
NEXT_PUBLIC_MAP_PROVIDER=osm
# Optional Mapbox / Google Maps API Key
NEXT_PUBLIC_MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# Push Notifications (STRICTLY SERVER-SIDE)
# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (Android)
FCM_PROJECT_ID=fieldops-production
FCM_CLIENT_EMAIL=firebase-adminsdk@fieldops-production.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nplaceholder\n-----END PRIVATE KEY-----"

# Apple Push Notification Service (iOS)
APNS_KEY_ID=placeholder_key_id
APNS_TEAM_ID=placeholder_team_id
APNS_TOPIC=com.fieldops.app

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (STRICTLY SERVER-SIDE)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=placeholder-sendgrid-api-key
EMAIL_FROM=FieldOps <notifications@fieldops.com>

# ------------------------------------------------------------------------------
# Telemetry, Observability & Error Tracking
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=true
LOG_LEVEL=info
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000
SENTRY_AUTH_TOKEN=placeholder-sentry-release-auth-token
SENTRY_ORG=fieldops
SENTRY_PROJECT=fieldops-web
