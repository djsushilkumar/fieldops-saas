# ==============================================================================
# FieldOps Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - NEVER commit .env, .env.local, or actual secret keys to source control.
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# - Variables without NEXT_PUBLIC_ are strictly server-side and must never leak.
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public API URL for Supabase Gateway (Exposed to Web & Mobile clients)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public Anonymous Client Key (Exposed to Web & Mobile clients; respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-anon-key-local

# Privileged Service Role Key (STRICTLY SERVER-SIDE - NEVER EXPOSE TO CLIENTS)
# Used only by background workers, admin edge functions, and database seeding
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-service-role-key-local

# ------------------------------------------------------------------------------
# Server-Side Secrets & Cryptographic Keys (STRICTLY SERVER-SIDE)
# ------------------------------------------------------------------------------
# Master encryption secret for encrypting sensitive fields at rest (AES-256-GCM)
SERVER_SECRET_MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Direct Connection URL (Used by migrations; not exposed to web clients)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# Web Client Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ------------------------------------------------------------------------------
# Telemetry & Observability (Optional in local development)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
LOG_LEVEL=debug
